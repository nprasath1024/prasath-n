{
  "name": "ajv-keywords",
  "version": "5.1.0",
  "description": "Additional JSON-Schema keywords for Ajv JSON validator",
  "license": "MIT",
  "author": "Evgeny Poberezkin",
  "homepage": "https://github.com/epoberezkin/ajv-keywords#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/epoberezkin/ajv-keywords.git"
  },
  "bugs": {
    "url": "https://github.com/epoberezkin/ajv-keywords/issues"
  },
  "main": "dist/index.js",
  "files": [
    "ajv-keywords.d.ts",
    "dist",
    "src"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "eslint": "eslint \"src/**/*.*s\" \"spec/**/*.*s\"",
    "prepublish": "npm run build",
    "test": "npm link && npm link ajv-keywords && npm run eslint && npm run test-cov",
    "test-cov": "jest spec/*.ts --coverage",
    "test-spec": "jest spec/*.ts",
    "prettier:check": "prettier --list-different \"./**/*.{md,json,yaml,js,ts}\"",
    "prettier:write": "prettier --write \"./**/*.{md,json,yaml,js,ts}\""
  },
  "types": "dist/index.d.ts",
  "dependencies": {
    "fast-deep-equal": "^3.1.3"
  },
  "peerDependencies": {
    "ajv": "^8.8.2"
  },
  "devDependencies": {
    "@ajv-validator/config": "^0.2.3",
    "@types/chai": "^4.2.14",
    "@types/jest": "^26.0.14",
    "@types/node": "^16.4.10",
    "@types/uuid": "^8.3.0",
    "@typescript-eslint/eslint-plugin": "^4.4.1",
    "@typescript-eslint/parser": "^4.4.1",
    "ajv": "^8.8.2",
    "ajv-formats": "^2.0.0",
    "chai": "^4.2.0",
    "eslint": "^7.2.0",
    "eslint-config-prettier": "^7.0.0",
    "husky": "^7.0.1",
    "jest": "^26.5.3",
    "json-schema-test": "^2.0.0",
    "lint-staged": "^11.1.1",
    "prettier": "^2.1.2",
    "ts-jest": "^26.4.1",
    "typescript": "^4.2.0",
    "uuid": "^8.1.0"
  },
  "keywords": [
    "JSON-Schema",
    "ajv",
    "keywords"
  ],
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged && npm test"
    }
  },
  "lint-staged": {
    "*.{md,json,yaml,js,ts}": "prettier --write"
  },
  "prettier": "@ajv-validator/config/prettierrc.json"
}
