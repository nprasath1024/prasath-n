{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "type": [
    "object",
    "boolean"
  ],
  "$id": "https://json-schema.org/draft/2019-09/meta/meta-data",
  "$recursiveAnchor": true,
  "$vocabulary": {
    "https://json-schema.org/draft/2019-09/vocab/meta-data": true
  },
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "default": true,
    "deprecated": {
      "type": "boolean",
      "default": false
    },
    "readOnly": {
      "type": "boolean",
      "default": false
    },
    "writeOnly": {
      "type": "boolean",
      "default": false
    },
    "examples": {
      "type": "array",
      "items": true
    }
  },
  "title": "Meta-data vocabulary meta-schema"
}
